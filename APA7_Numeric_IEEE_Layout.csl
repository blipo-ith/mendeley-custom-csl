<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Andalan APA 7 Numeric - Fixed</title>
    <title-short>APA7 Numeric Fixed</title-short>
    <id>http://www.zotero.org/styles/andalan-apa7-numeric-fixed</id>
    <link href="http://www.zotero.org/styles/andalan-apa7-numeric-fixed" rel="self"/>
    <author>
      <name>Andalan Publisher</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Numeric citations in order of appearance, with APA-style references and aligned numbered bibliography.</summary>
    <updated>2026-11-22T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="symbol" delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued" prefix="(" suffix=")">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short" prefix="(" suffix=")"/>
      </else>
    </choose>
  </macro>
  <macro name="date-full">
    <choose>
      <if variable="issued">
        <date variable="issued" prefix="(" suffix=")">
          <date-part name="year"/>
          <date-part name="month" prefix=", "/>
          <date-part name="day" prefix=" "/>
        </date>
      </if>
      <else>
        <text term="no date" form="short" prefix="(" suffix=")"/>
      </else>
    </choose>
  </macro>
  <macro name="doi-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else>
        <text variable="URL"/>
      </else>
    </choose>
  </macro>
  <macro name="journal-details">
    <group delimiter=", ">
      <group>
        <text variable="volume" font-style="italic"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="entry">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="year" suffix="."/>
          <text variable="title" text-case="sentence" suffix="."/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <text macro="journal-details"/>
          </group>
          <text macro="doi-url"/>
        </group>
      </if>
      <else-if type="book">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="year" suffix="."/>
          <group delimiter=" ">
            <text variable="title" text-case="sentence" font-style="italic"/>
            <group prefix="(" suffix=")">
              <number variable="edition" form="ordinal" suffix=" ed."/>
            </group>
          </group>
          <text variable="publisher" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="year" suffix="."/>
          <text variable="title" text-case="sentence" suffix="."/>
          <group delimiter=" ">
            <text value="In"/>
            <names variable="editor">
              <name initialize-with=". " delimiter=", " and="symbol"/>
              <label form="short" prefix=" (" suffix="),"/>
            </names>
            <text variable="container-title" text-case="sentence" font-style="italic"/>
            <text variable="page" prefix="(pp. " suffix=")."/>
          </group>
          <text variable="publisher" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="year" suffix="."/>
          <group delimiter=" ">
            <text variable="title" text-case="sentence" font-style="italic"/>
            <group prefix="[" suffix="]" delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </group>
          <text variable="archive" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="date-full" suffix="."/>
          <text variable="title" text-case="sentence" font-style="italic" suffix="."/>
          <text variable="publisher" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation>
    <layout delimiter=", ">
      <text variable="citation-number" prefix="[" suffix="]"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry" prefix=" "/>
    </layout>
  </bibliography>
</style>
