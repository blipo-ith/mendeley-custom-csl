<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>APA 7th Edition - Numeric Bracket (Andalan)</title>
    <id>http://www.zotero.org/styles/apa-7th-numeric-bracket-andalan</id>
    <link href="http://www.zotero.org/styles/apa-7th-numeric-bracket-andalan" rel="self"/>
    <link href="http://www.zotero.org/styles/apa" rel="template"/>
    <author>
      <name>Custom style</name>
    </author>
    <category citation-format="numeric"/>
    <summary>Numeric bracket citations in order of appearance with an APA 7-inspired reference list.</summary>
    <updated>2026-11-22T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="and"> &amp; </term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">p.</term>
      <term name="pages" form="short">pp.</term>
      <term name="editor" form="short">Ed.</term>
      <term name="editors" form="short">Eds.</term>
      <term name="no date">n.d.</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else><text term="no date"/></else>
    </choose>
  </macro>

  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="title"/>
      </if>
      <else-if type="paper-conference" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group delimiter="">
            <text variable="volume" font-style="italic"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=", ">
          <text term="in" text-case="lowercase"/>
          <names variable="editor" prefix=" " suffix=" ">
            <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
          <text variable="container-title" font-style="italic"/>
          <text variable="page" prefix="(pp. "/>
        </group>
      </else-if>
      <else-if variable="publisher">
        <text variable="publisher"/>
      </else-if>
    </choose>
  </macro>

  <macro name="doi-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="" suffix="" delimiter=", ">
      <group prefix="[" suffix="]">
        <text variable="citation-number"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="issued" prefix="(" suffix=")"/>
        <text macro="title"/>
        <text macro="container"/>
      </group>
      <text macro="doi-url" prefix=". "/>
    </layout>
  </bibliography>
</style>
