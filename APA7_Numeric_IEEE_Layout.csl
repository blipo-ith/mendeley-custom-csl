<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" page-range-format="expanded">
  <info>
    <title>APA 7 Numeric (IEEE-Style Numbered Bibliography)</title>
    <title-short>Andalan APA7 Numeric</title-short>
    <id>http://www.zotero.org/styles/andalan-apa7-numeric-ieee-layout</id>
    <link href="http://www.zotero.org/styles/andalan-apa7-numeric-ieee-layout" rel="self"/>
    <link href="https://apastyle.apa.org/style-grammar-guidelines/references/examples" rel="documentation"/>
    <author><name>Andalan Publisher</name></author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>APA 7 reference elements with numbered references in order of appearance, aligned labels, and separate bracketed numeric citations.</summary>
    <updated>2026-11-22T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author" delimiter=", " et-al-min="21" et-al-use-first="19" et-al-use-last="true">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="symbol" delimiter-precedes-last="always"/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued" prefix="(" suffix=")">
          <date-part name="year"/>
          <date-part name="month" prefix=", "/>
          <date-part name="day" prefix=" "/>
        </date>
      </if>
      <else><text term="no date" form="short" prefix="(" suffix=")"/></else>
    </choose>
  </macro>
  <macro name="date-year-only">
    <choose>
      <if variable="issued"><date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date></if>
      <else><text term="no date" form="short" prefix="(" suffix=")"/></else>
    </choose>
  </macro>
  <macro name="journal-source">
    <group>
      <text variable="container-title" font-style="italic"/>
      <group prefix=", ">
        <text variable="volume" font-style="italic"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page" prefix=", "/>
      <text variable="article-number" prefix=", "/>
    </group>
  </macro>
  <macro name="doi-url">
    <choose>
      <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
      <else><text variable="URL"/></else>
    </choose>
  </macro>
  <macro name="entry">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="date-year-only" suffix="."/>
          <text variable="title" text-case="sentence" suffix="."/>
          <text macro="journal-source" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </if>
      <else-if type="book">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="date-year-only" suffix="."/>
          <group delimiter=" ">
            <text variable="title" font-style="italic" text-case="sentence"/>
            <text variable="edition" prefix="(" suffix=" ed.)"/>
          </group>
          <text variable="publisher" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="date-year-only" suffix="."/>
          <text variable="title" text-case="sentence" suffix="."/>
          <group delimiter=" ">
            <text value="In"/>
            <names variable="editor"><name initialize-with=". " and="symbol"/><label form="short" prefix=" (" suffix="),"/></names>
            <text variable="container-title" font-style="italic"/>
            <text variable="page" prefix="(pp. " suffix=")"/>
          </group>
          <text variable="publisher" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="date-year-only" suffix="."/>
          <group delimiter=" ">
            <text variable="title" font-style="italic" text-case="sentence"/>
            <group prefix="[" suffix="]" delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </group>
          <text variable="archive" suffix="."/>
          <text macro="doi-url"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <text macro="author" suffix="."/>
          <text macro="year" suffix="."/>
          <text variable="title" text-case="sentence" font-style="italic" suffix="."/>
          <choose>
            <if variable="container-title"><text variable="container-title" suffix="."/></if>
            <else><text variable="publisher" suffix="."/></else>
          </choose>
          <text macro="doi-url"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation>
    <sort><key variable="citation-number"/></sort>
    <layout delimiter=", ">
      <text variable="citation-number" prefix="[" suffix="]"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort><key variable="citation-number"/></sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry" prefix=" "/>
    </layout>
  </bibliography>
</style>
